  "disk": 120,
  "gpu_query": "gpu_ram>=79 num_gpus=1 compute_cap>=900 compute_cap<1000 cuda_vers>=12.4",
  "expected_gpu": "H100",
  "bound": "compute",
  "weights_mode": "download",
  "env": {
    "HF_ONLINE": "1",
    "HF_HUB_DISABLE_XET": "1"
