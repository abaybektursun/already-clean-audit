  "_comment": "MENDELEEV S1b pack 5c_beh+5c_graft. Same job modules as the AWS lane via the mdl_job shim. Hopper-only so the Vast lane is one hardware class (confound 27); the dose-0 identity check measures any cross-lane drift. Smoke cell first: it must bank metrics.json and exit 0 before the real cells run.",
  "cells": [
    {
      "id": "smoke",
      "module": "infra.vast.cells.mdl_job",
      "job": "infra.aws_pg.jobs.matrix_behaviour",
      "args": "--row 5c --cols F1,F2,F3,F4,F5,H,K,K-null,P,RFP,S,S-k,ppl --halves discovery,confirmation --smoke"
    },
    {
      "id": "5c_beh",
      "module": "infra.vast.cells.mdl_job",
      "job": "infra.aws_pg.jobs.matrix_behaviour",
      "args": "--row 5c --cols F1,F2,F3,F4,F5,H,K,K-null,P,RFP,S,S-k,ppl --halves discovery,confirmation"
    },
    {
      "id": "5c_graft",
      "module": "infra.vast.cells.mdl_job",
      "job": "infra.aws_pg.jobs.matrix_graft",
